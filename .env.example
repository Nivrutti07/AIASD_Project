# =========================================================================
# Blood Donation & Emergency Request System - Environment Configuration
# =========================================================================

NODE_ENV=development
PORT=5000

# Authentication Secret
JWT_SECRET=blood_bank_jwt_secure_secret_key_2026
JWT_EXPIRES_IN=24h

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=blood_donation_db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blood_donation_db

# Fallback mode (Set to true to force pg-mem in-memory PostgreSQL engine)
USE_IN_MEMORY_DB=false

# Report CSV Storage Directory
STORAGE_DIR=./storage
